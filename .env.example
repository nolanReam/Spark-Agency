# Browser configuration. This must match STUDENT_AUTH_EMAIL_DOMAIN in the
# signup-student Edge Function environment.
VITE_STUDENT_AUTH_EMAIL_DOMAIN=students.example.com

# Edge Function environment examples (configure these with Supabase secrets;
# do not put production values in Vite environment variables). The allowed
# origins list is shared by all three signup functions.
# STUDENT_AUTH_EMAIL_DOMAIN=students.example.com
# STUDENT_SIGNUP_ALLOWED_ORIGINS=https://your-app.vercel.app,http://localhost:5173
# VOLUNTEER_SIGNUP_CODE=replace-with-a-server-only-secret
# INSTRUCTOR_SIGNUP_CODE=replace-with-a-different-server-only-secret
